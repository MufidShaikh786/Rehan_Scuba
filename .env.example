# Copy to .env.local and fill with values from Firebase Console > Project settings > Your apps.
# Firebase web config is visible in the browser by design; Firestore and Storage rules protect data.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=replace-me

# Set these only after deploying the matching Firebase Functions and API credentials.
VITE_INSTAGRAM_ENDPOINT=
VITE_GOOGLE_REVIEWS_ENDPOINT=

# Optional public URLs. Keep unset until the business confirms the real profiles.
VITE_INSTAGRAM_URL=
VITE_GOOGLE_BUSINESS_URL=
